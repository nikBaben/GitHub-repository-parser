# GitHub Personal Access Token (Bearer token) для авторизации в API
TOKEN=

# URL репозитория GitHub (используется как входной параметр)
GITHUB_URL=https://github.com/thunderbird/thunderbolt

# Базовый URL GitHub REST API
GITHUB_API_URL=https://api.github.com

# Версия GitHub API (рекомендуется фиксировать для стабильности)
GITHUB_API_VERSION=2022-11-28

# Таймаут HTTP-запросов (в секундах)
DEFAULT_TIMEOUT=40

# Количество элементов на страницу при пагинации
DEFAULT_PER_PAGE=100

# Количество повторных попыток при ошибках запросов
DEFAULT_RETRIES=4
